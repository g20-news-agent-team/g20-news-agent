# 本地开发示例，配置项随基础运行环境一起验证。
APP_ENV=development
BACKEND_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL 连接串，请在本地环境中设置。
DATABASE_URL=

# 千问接入参数待验证，API Key 仅由后端读取。
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_TEXT_MODEL=
QWEN_EMBEDDING_MODEL=

# 会话密钥由运行环境提供，HTTPS 部署时启用安全 Cookie。
SESSION_SECRET=
SESSION_COOKIE_SECURE=
SESSION_TTL_SECONDS=

# 来源、采集频率和存储路径待团队确认。
NEWS_COLLECTION_ENABLED=false
NEWS_SOURCES_CONFIG=
FILE_STORAGE_PATH=
